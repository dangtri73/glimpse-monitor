MONITOR_AGENT_URL=http://127.0.0.1:8765
AI_SERVICE_URL=http://127.0.0.1:8771
AI_CHAT_MODEL=gemma3:270m
AI_CHAT_TIMEOUT_MS=70000
GATEWAY_ID=dev-gateway

# Enable Next.js API request events to Kafka.
# Leave KAFKA_BROKERS empty to disable publishing without changing code.
GATEWAY_REQUEST_EVENTS_ENABLED=true
GATEWAY_REQUEST_EVENTS_LOG_FAILURES=false
KAFKA_BROKERS=127.0.0.1:9094
KAFKA_CLIENT_ID=glimpse-dashboard
KAFKA_GATEWAY_REQUEST_TOPIC=gateway.requests.raw
KAFKA_PUBLISH_TIMEOUT_MS=75
