KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8082
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824
KAFKA_ENRICHER_GROUP_ID=gateway-request-enricher
KAFKA_ANALYTICS_GROUP_ID=gateway-analytics-writer
