POSTGRES_DB=glimpse_monitor
POSTGRES_USER=glimpse
POSTGRES_PASSWORD=glimpse
POSTGRES_PORT=5433
POSTGRES_INIT_SQL=./sql/monitor_schema.sql

DOCKERHUB_NAMESPACE=dangtri73
IMAGE_TAG=latest
IMAGE_PREFIX=glimpse-monitor
DASHBOARD_IMAGE=dangtri73/glimpse-monitor-dashboard:latest
AI_SERVICE_IMAGE=dangtri73/glimpse-monitor-ai-service:latest
WORKERS_IMAGE=dangtri73/glimpse-monitor-workers:latest

DASHBOARD_PORT=3000
DASHBOARD_BIND_HOST=0.0.0.0
MONITOR_AGENT_URL=http://host.docker.internal:8765
MONITOR_AGENT_ADMIN_TOKEN=
AI_SERVICE_URL=http://ai-service:8770
AI_CHAT_MODEL=gemma3:270m
AI_CHAT_TIMEOUT_MS=70000
GATEWAY_ID=dev-gateway
GATEWAY_REQUEST_EVENTS_ENABLED=true
GATEWAY_REQUEST_EVENTS_LOG_FAILURES=false
KAFKA_CLIENT_ID=glimpse-dashboard
KAFKA_GATEWAY_REQUEST_TOPIC=gateway.requests.raw
KAFKA_PUBLISH_TIMEOUT_MS=75

AGENT_PYTHON=/usr/bin/python3
GLIMPSE_AGENT_DIR=./agent
GLIMPSE_AGENT_LOG_DIR=./logs/agent
GLIMPSE_AGENT_LAUNCHD_LABEL=site.glimpse.monitor.agent
# Leave empty to auto-select gui/<uid> when available, otherwise user/<uid>.
GLIMPSE_AGENT_LAUNCHD_DOMAIN=
# If true, deploy may stop an existing Python server.py listener on GLIMPSE_AGENT_PORT.
GLIMPSE_AGENT_REPLACE_PORT_OWNER=true
# If true, deploy picks a nearby free port when GLIMPSE_AGENT_PORT is occupied by an unknown process.
GLIMPSE_AGENT_AUTO_PORT_FALLBACK=true
GLIMPSE_AGENT_HOST=127.0.0.1
GLIMPSE_AGENT_PORT=8765
GLIMPSE_AGENT_POLL_SECONDS=2
GLIMPSE_AGENT_CORS_ORIGIN=http://localhost:3000
GLIMPSE_AGENT_LOG_REQUESTS=false
GLIMPSE_AGENT_ENABLE_SERVICE_ACTIONS=false
GLIMPSE_AGENT_ENABLE_NGINX_APPLY=false
GLIMPSE_AGENT_ADMIN_TOKEN=

REDIS_PORT=6380

KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8082
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824
KAFKA_ENRICHER_GROUP_ID=gateway-request-enricher
KAFKA_ANALYTICS_GROUP_ID=gateway-analytics-writer
WORKER_KAFKA_SEND_TIMEOUT_SECONDS=10
WORKER_KAFKA_POLL_TIMEOUT_MS=1000
WORKER_CLICKHOUSE_BATCH_SIZE=500

CLICKHOUSE_DB=glimpse_gateway
CLICKHOUSE_USER=glimpse
CLICKHOUSE_PASSWORD=glimpse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

ADMINER_PORT=8081

AI_SERVICE_HOST_PORT=8771
AI_SERVICE_BIND_HOST=0.0.0.0
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:270m
OLLAMA_TIMEOUT_SECONDS=60

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d

GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=glimpse

POSTGRES_BACKUP_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_RETENTION_DAYS=14
