map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name _;

    return 444;
}

server {
    listen 80;
    server_name ${DEV_DOMAIN};

    client_max_body_size 25m;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass ${DEFAULT_UPSTREAM};
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

