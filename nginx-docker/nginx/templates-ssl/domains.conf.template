map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name _;

    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate ${GLIMPSE_SSL_CERTIFICATE};
    ssl_certificate_key ${GLIMPSE_SSL_CERTIFICATE_KEY};
    include /etc/nginx/snippets/ssl.conf;

    return 444;
}

server {
    listen 80;
    server_name ${FRONT_DOMAIN} ${BACK_DOMAIN} ${EMBED_DOMAIN} ${RERANK_DOMAIN} ${MLX_DOMAIN};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${MLX_DOMAIN};

    ssl_certificate ${GLIMPSE_SSL_CERTIFICATE};
    ssl_certificate_key ${GLIMPSE_SSL_CERTIFICATE_KEY};
    include /etc/nginx/snippets/ssl.conf;

    client_max_body_size 25m;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass ${MLX_UPSTREAM};
        include /etc/nginx/snippets/mlx-stream-proxy.conf;
    }
}

